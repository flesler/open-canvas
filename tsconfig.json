{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "cursor/canvas": ["./node_modules/@thisismydesign/cursor-canvas-web"],
      "@open-canvas/user-canvas": ["./example/pushflow.canvas.tsx"]
    }
  },
  "include": ["host", "example", "types", "scripts"]
}
