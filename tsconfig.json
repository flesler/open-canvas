{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "cursor/canvas": [
        "./node_modules/@flesler/cursor-canvas-web/src/superset/index.d.ts",
        "./node_modules/@flesler/cursor-canvas-web/src/vendor/canvas-sdk/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "example/showcase.canvas.tsx"
  ]
}
