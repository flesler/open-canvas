{
  "name": "@flesler/open-canvas",
  "version": "1.0.3",
  "description": "Generate Cursor canvases to HTML, PNG, PDF, and IDE-ready .canvas.tsx",
  "type": "module",
  "license": "MIT",
  "repository": "github:flesler/open-canvas",
  "bin": {
    "open-canvas": "./bin/open-canvas.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:cli",
    "build:cli": "tsc -b tsconfig.cli.json --clean && tsc -b tsconfig.cli.json && find dist -name '*.d.ts' -delete",
    "prepublishOnly": "npm run build:cli",
    "prepare": "[ \"$CI\" != \"true\" ] && [ -d node_modules/husky ] && husky || true",
    "eslint": "eslint --cache --cache-strategy content",
    "lint": "npm run eslint -- 'src/**/*.ts' 'src/**/*.tsx' 'example/**/*.canvas.tsx'",
    "lint:fix": "npm run lint -- --fix",
    "vitest": "VITE_CJS_IGNORE_WARNING=true vitest",
    "test": "npm run test:types && npm run test:unit",
    "test:smoke": "bin/smoke.sh",
    "test:smoke:global": "bin/smoke.sh --global",
    "test:smoke:both": "bin/smoke.sh --both",
    "test:contract": "bin/contract.sh",
    "test:unit": "npm run vitest -- run",
    "test:types:cli": "tsc -p tsconfig.cli.json --noEmit",
    "test:types:app": "tsc -p tsconfig.json",
    "test:types": "npm run test:types:cli && npm run test:types:app",
    "test:unit:min": "MINIMAL=1 npm run test:unit",
    "test:unit:verbose": "VERBOSE=1 npm run test:unit",
    "lint:full": "bin/parallel-run.sh test:types:cli test:types:app lint:fix",
    "lint:full:silent": "bin/parallel-run.sh --silent test:types:cli test:types:app lint:fix && echo LINT OK",
    "agent:stop": "npm run -s lint:full:silent",
    "changelog": "auto-changelog --commit-limit 100 --hide-credit"
  },
  "dependencies": {
    "@flesler/cursor-canvas-web": "file:../cursor-canvas-web",
    "@mantine/charts": "^8.3.1",
    "@mantine/core": "^8.3.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "commander": "^13.1.0",
    "d3-dsv": "^3.0.1",
    "playwright": "^1.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "ts-morph": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.9",
    "vite-plugin-singlefile": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "bin/open-canvas.js",
    "dist/**/*.js",
    "LICENSE",
    "src/shell",
    "src/types",
    "src/md/SKILL.md",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.cli.json"
  ]
}
