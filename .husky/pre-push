#!/bin/sh

if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use
fi

# Lighter than CI: pre-commit already ran lint:full + test:unit. verify + smoke run in GitHub Actions.
if ! npm run build:cli; then
  echo "pre-push: build:cli failed"
  exit 1
fi

if ! npm run test:contract; then
  echo "pre-push: verify fixtures failed"
  exit 1
fi
