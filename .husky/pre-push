#!/bin/sh

if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use
fi

# Matches .github/workflows/ci.yml (pre-commit already runs lint:full + test:unit).
if ! npm run build:cli; then
  echo "pre-push: build:cli failed"
  exit 1
fi

if ! npm run test:contract; then
  echo "pre-push: test:contract failed"
  exit 1
fi

if ! npm run test:smoke; then
  echo "pre-push: test:smoke failed"
  exit 1
fi
